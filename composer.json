{
  "name": "vendor/laravel-payment-reconciliation",
  "description": "Reliable payment state management, idempotency, and provider reconciliation for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "payments",
    "reconciliation",
    "idempotency",
    "webhooks"
  ],
  "authors": [
    {
      "name": "Raedev",
      "email": "raed_nb@hotmail.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/database": "^10.0|^11.0",
    "illuminate/console": "^10.0|^11.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.12",
    "laravel/pint": "^1.30",
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "VendorName\\LaravelPaymentReconciliation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "VendorName\\LaravelPaymentReconciliation\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "VendorName\\LaravelPaymentReconciliation\\PaymentReconciliationServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
